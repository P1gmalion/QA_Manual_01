			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"200 OK при видаленні користувача\", function () {\r",
							"  pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"let message;\r",
							"try {\r",
							"  const body = pm.response.json();\r",
							"  message = body.message || JSON.stringify(body);\r",
							"} catch (e) {\r",
							"  message = pm.response.text();\r",
							"}\r",
							"\r",
							"pm.test(\"Повідомлення про успішне видалення\", function () {\r",
							"  pm.expect(message).to.include(\"deleted\");\r",
							"});"
						],
