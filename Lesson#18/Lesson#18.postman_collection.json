		{
			"name": "Update data Positive",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"200 OK при оновленні користувача\", function () {\r",
							"  pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"let body;\r",
							"let bodyText = pm.response.text();\r",
							"\r",
							"try {\r",
							"  body = pm.response.json();\r",
							"} catch (e) {\r",
							"  body = null;\r",
							"}\r",
							"\r",
							"pm.test(\"Повідомлення про оновлення користувача\", function () {\r",
							"  const haystack = body\r",
							"    ? (body.message ? String(body.message) : JSON.stringify(body))\r",
							"    : bodyText;\r",
							"  pm.expect(haystack).to.include(\"updated\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"protocolProfileBehavior": {
				"disabledSystemHeaders": {}
			},
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"id\": \"{{userId}}\",\r\n  \"name\": \"{{newUserName}}\",\r\n  \"age\": {{newUserAge}},\r\n  \"gender\": \"{{userGender}}\",\r\n  \"city\": \"{{newUserCity}}\"\r\n}\r\n"
				},
				"url": {
					"raw": "{{baseUrl}}/accounts/{{accountId}}/users/{{userId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"accounts",
						"{{accountId}}",
						"users",
						"{{userId}}"
					]
				}
			},
			"response": []
		},
		{
