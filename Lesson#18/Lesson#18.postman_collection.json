	"item": [
		{
			"name": "Post data Positive",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"200 OK на створення користувача\", function () {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"const body = pm.response.json();",
							"",
							"pm.test(\"У відповіді є id (створений користувач)\", function () {",
							"  pm.expect(body).to.have.property(\"id\");",
							"});",
							"",
							"if (body.id) {",
							"  pm.environment.set(\"userId\", body.id);",
							"}",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"packages": {},
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"{{userName}}\",\n    \"age\": {{userAge}},\n    \"gender\": \"{{userGender}}\",\n    \"city\": \"{{userCity}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/users",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users"
					]
				},
				"description": "This is a POST request, submitting data to an API via the request body. This request submits JSON data, and the data is reflected in the response.\n\nA successful POST request typically returns a `200 OK` or `201 Created` response code."
			},
			"response": []
		},
